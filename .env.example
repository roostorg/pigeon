# Copy to .env and edit. Used by:
#   uv run --env-file .env pigeon
#   docker compose up   (compose loads .env; container overrides HOST/DB/MODELSPECS paths)
# The app itself does not auto-load .env when run without --env-file.

# "development" or "production" (the default when unset). Production requires a master
# token and pepper; generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PIGEON_ENV=development

# Provider backend: "mock" for local/dev/tests, "live" to call real inference via LiteLLM.
PIGEON_PROVIDER=mock

# Native default is 127.0.0.1. Containers should use 0.0.0.0.
PIGEON_HOST=127.0.0.1
PIGEON_PORT=8900

# Where model spec YAML lives.
PIGEON_MODELSPECS_DIR=modelspecs

# SQLite file for per-org policies and model spec enablement.
PIGEON_DB_PATH=pigeon.db

# Master token for admin org/token APIs. Keep it secret.
PIGEON_MASTER_TOKEN=dev-master-token
PIGEON_TOKEN_PEPPER=dev-token-pepper

# Optional bootstrap JSON map of bearer token -> org id. It is imported into an empty DB
# only; runtime auth uses the hashed tokens in SQLite.
# Tokens may not contain whitespace. Keep the single quotes: unquoted, the dotenv parser
# strips the inner double quotes and the JSON no longer parses.
PIGEON_TOKENS='{"dev-token":"dev-org"}'

# For Docker secrets, set this to a mounted JSON file instead of PIGEON_TOKENS.
# PIGEON_TOKENS_FILE=/run/secrets/pigeon_tokens

# Set to 1 to import any missing YAML versions into an existing DB.
# PIGEON_SEED_MODELSPECS=1

# Max bytes Pigeon will download from a classify mediaUrl (live provider). Default 10000000.
# PIGEON_MEDIA_MAX_BYTES=10000000

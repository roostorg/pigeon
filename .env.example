# Load with: uv run --env-file .env pigeon
# (nothing reads .env automatically)

# "development" or "production" (the default when unset). Production refuses to start
# without PIGEON_TOKENS, rejects the default dev-token, and requires tokens of at least
# 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PIGEON_ENV=development

# Provider backend: "mock" for local/dev/tests, "live" to call real inference via LiteLLM.
PIGEON_PROVIDER=mock

# Where model spec YAML lives.
PIGEON_MODELSPECS_DIR=modelspecs

# SQLite file for per-org policies and model spec enablement.
PIGEON_DB_PATH=pigeon.db

# JSON map of bearer token -> org id. Each consumer (Coop, Osprey) gets one.
# Optional in development (defaults to dev-token -> dev-org); required in production.
# Tokens may not contain whitespace. Keep the single quotes: unquoted, the dotenv parser
# strips the inner double quotes and the JSON no longer parses.
PIGEON_TOKENS='{"dev-token":"dev-org"}'
